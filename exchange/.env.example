# Copy to exchange/.env for local Hub bridge + payments + optional Postgres

HUB_API_URL=http://localhost:4000/api/v1
HUB_APP_URL=http://localhost:3002
# Production Exchange API must set HUB_APP_URL=https://www.pinithub.com
# SHARE_PUBLIC_BASE_URL=https://www.pinithub.com
EXCHANGE_BRIDGE_SECRET=change_me_exchange_bridge_secret_min_32_chars
EXCHANGE_PUBLIC_URL=http://localhost:5174
PORT=5000
# Optional — Razorpay webhook signature secret (defaults to RAZORPAY_KEY_SECRET)
# RAZORPAY_WEBHOOK_SECRET=
# Production Exchange (Vercel) must point Hub SSO at the live Hub UI:
# VITE_HUB_APP_URL=https://www.pinithub.com
# Dead alias (do not use): https://dna-pinit-web.vercel.app
VITE_HUB_APP_URL=http://localhost:3002

# ─── Database ─────────────────────────────────────────────────────────────────
# Local / tests (default): omit both URLs, or set EXCHANGE_FORCE_SQLITE=1.
# Isolated tests: EXCHANGE_ISOLATED_TEST=1 (always SQLite; ignores production URLs).
# Production: EXCHANGE_DATABASE_URL or DATABASE_URL is REQUIRED (postgresql://).
# A production process with no URL will refuse to start — it will not open SQLite.
# EXCHANGE_DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-....pooler.supabase.com:6543/postgres
# EXCHANGE_DB_PATH=  (tests only — SQLite file override)

# ─── Supabase Storage (same project URL; Exchange buckets only) ───────────────
# Never put Hub vault masters in these buckets. Never use Hub vault encryption keys.
EXCHANGE_SUPABASE_URL=https://kqdqmimdqecensurjplh.supabase.co
EXCHANGE_SUPABASE_ANON_KEY=
# Optional — bucket create / private delivery upload (server-only). Prefer creating
# buckets via SQL in server/schema/exchange.storage.sql so this can stay empty.
# EXCHANGE_SUPABASE_SERVICE_KEY=

# ─── Payments (Razorpay) ─────────────────────────────────────────────────────
# Leave empty for mock payments (local seal without charging).
# Set both keys to open live Razorpay Checkout.js on buy / cart checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Force mock even if keys are present: PAYMENT_MOCK=1
# PAYMENT_MOCK=1

# Server-only secrets (never VITE_* / never commit real .env):
# EXCHANGE_DATABASE_URL, EXCHANGE_BRIDGE_SECRET, EXCHANGE_SUPABASE_SERVICE_KEY, RAZORPAY_KEY_SECRET
