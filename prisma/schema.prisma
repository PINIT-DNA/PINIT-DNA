// ─── Universal Asset Protection (additive — does not replace ProtectedPost) ───

enum AssetType {
  IMAGE
  VIDEO
  DOCUMENT
  AUDIO
  OTHER
}

enum AssetStatus {
  DRAFT
  PROTECTED
  MONITORING
  DISCOVERY
  INVESTIGATING
  RESOLVED
  ARCHIVED
  FAILED
}

/// Review lifecycle of one AssetVersion.
///
/// Deliberately separate from AssetStatus, which is a protection/monitoring
/// lifecycle (PROTECTED, MONITORING, DISCOVERY...). Overloading that enum would
/// conflate "is this asset watched for leaks" with "has the client signed it off".
enum ReviewStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  IN_PROGRESS
  APPROVED
  SUPERSEDED
}

/// COMMENT is discussion. CHANGE_REQUEST is work someone must act on, and is
/// what drives the "needs attention" counters on the campaign overview.
enum CommentKind {
  COMMENT
  CHANGE_REQUEST
}

/// The two things a reviewer can decide. Deliberately only two: an approval
/// workflow with more outcomes than this becomes one nobody can reason about.
enum ApprovalDecision {
  APPROVED
  CHANGES_REQUESTED
}

/// Shared by both kinds. A plain comment normally only ever sees OPEN and
/// RESOLVED; the middle states carry a change request through its lifecycle.
enum CommentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
  CLOSED
}

/// One message in a campaign conversation between the team and the client.
///
/// Campaign-scoped, not global: every message belongs to exactly one campaign,
/// so two clients can never see each other and a message cannot be addressed to
/// "the business" in the abstract. Optionally narrowed further to an asset or a
/// version, which is what keeps "change the logo" attached to the thing it is
/// about instead of floating in one long channel.
///
/// Unread is tracked per side rather than with a single flag: a message from the
/// client is unread for the team until the team opens it, and the reverse. One
/// shared flag would let either party mark the other's messages read.
model CampaignMessage {
  id             String   @id @default(uuid())
  createdAt      DateTime @default(now())

  organizationId String
  campaignId     String
  /// Optional narrowing. Null means the message is about the campaign itself.
  assetId        String?
  versionId      String?

  /// Exactly one of these identifies the author, or neither when isSystem.
  authorUserId      String?
  authorRecipientId String?
  /// Denormalised so a thread still reads correctly if a member later leaves.
  authorLabel       String
  /// System lines ("Version 3 uploaded") are part of the conversation but are
  /// written by the platform, not a person.
  isSystem       Boolean  @default(false)

  body           String   @db.Text

  readByTeamAt   DateTime?
  readByClientAt DateTime?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@index([assetId, createdAt])
  @@index([campaignId, readByTeamAt])
  @@index([organizationId])
  @@map("campaign_messages")
}

/// A decision recorded against one version. Insert-only, never updated.
///
/// This is the audit claim — "Adhureddy approved version 3 on 25 Aug 2026" — so
/// it stores the evidence behind the claim, not just the outcome. A row keeps
/// the recipient, the token used, whether that token had been identity-verified,
/// and the device and IP it came from. Without that, an approval is only proof
/// that somebody held a URL.
///
/// There is no update path anywhere in the codebase. A decision is reversed by
/// recording a new one on a new version, never by rewriting this row.
model VersionApproval {
  id             String   @id @default(uuid())
  createdAt      DateTime @default(now())

  organizationId String
  clientId       String?
  campaignId     String
  assetId        String
  versionId      String

  decision       ApprovalDecision
  comment        String?  @db.Text

  /// Identity evidence. Exactly one of the two actor columns is set.
  approvedByUserId      String?
  approvedByRecipientId String?
  approverLabel         String
  shareToken            String?
  otpVerified           Boolean @default(false)
  deviceFingerprint     String?
  ipAddress             String?

  version AssetVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId, createdAt])
  @@index([campaignId, decision])
  @@index([organizationId, createdAt])
  @@index([assetId])
  @@map("version_approvals")
}

/// A comment or an actionable change request on one version of an asset.
///
/// Spec 13 is right that a change request is not merely a comment: it is
/// actionable and carries its own lifecycle. That distinction is kept with a
/// `kind` discriminator rather than a second table, so the two behave
/// differently in the UI and in queries while the team keeps one inbox and the
/// client keeps one mental model.
///
/// Always version-anchored. A comment that only names an asset becomes
/// meaningless the moment V2 lands.
model ReviewComment {
  id             String   @id @default(uuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organizationId String
  campaignId     String
  assetId        String
  versionId      String

  kind           CommentKind   @default(COMMENT)
  status         CommentStatus @default(OPEN)
  /// null = thread root. One level of nesting only; replies never nest further.
  parentId       String?

  /// Exactly one of these identifies the author. authorRecipientId is for a
  /// client reviewing through a share link, who has no user account.
  authorUserId      String?
  authorRecipientId String?
  /// Denormalised so a thread still reads correctly if a member later leaves.
  authorLabel       String

  body           String   @db.Text
  /// Team members named in the body, resolved at write time and notified once.
  mentionedUserIds String[] @default([])

  /// { type: "page" | "coordinate" | "timestamp" | "text", ... }
  /// Kept as JSON so a new asset type does not need a migration.
  anchor         Json?
  /// Set when a later version invalidates the anchor. The quoted text stays on
  /// the comment; the anchor is never relocated, because guessing where a
  /// changed heading moved to is worse than admitting it moved.
  anchorOrphaned Boolean  @default(false)

  resolvedAt       DateTime?
  resolvedByUserId String?

  version  AssetVersion    @relation(fields: [versionId], references: [id], onDelete: Cascade)
  parent   ReviewComment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies  ReviewComment[] @relation("CommentThread")

  @@index([versionId, createdAt])
  @@index([assetId, versionId, createdAt])
  @@index([campaignId, status])
  @@index([campaignId, kind, status])
  @@index([parentId])
  @@map("review_comments")
}

/// One immutable revision of a logical deliverable (V1 -> V2 -> V3).
///
/// Each version carries its OWN dnaRecordId / vaultId / certificateId, so a new
/// version is an INSERT and no code path ever rewrites a previous version's
/// protection columns. Immutability is therefore structural, not conventional.
///
/// This is NOT EvolutionLayer. That model is keyed dnaRecordId @unique and logs
/// fingerprint mutation *within a single file*; it cannot express a chain of
/// distinct files, each with its own DNA record.
///
/// Tenancy follows the business layer (organizationId), matching Campaign rather
/// than Asset.ownerUserId - see docs/BUSINESS_CLIENT_COLLABORATION_BLUEPRINT.md.
model AssetVersion {
  id             String   @id @default(uuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assetId        String
  versionNumber  Int
  organizationId String
  campaignId     String?

  /// Protection - one immutable set per version, never reused.
  dnaRecordId      String?
  vaultId          String?
  certificateId    String?
  contentHash      String?
  originalFilename String
  mimeType         String   @default("application/octet-stream")
  sizeBytes        Int      @default(0)

  reviewStatus    ReviewStatus @default(DRAFT)
  changeSummary   String?      @db.Text
  createdByUserId String

  /// Set when a later version replaces this one. Never deletes, never rewrites.
  supersededAt   DateTime?
  supersededById String?   @unique

  asset    Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  comments  ReviewComment[]
  approvals VersionApproval[]

  @@unique([assetId, versionNumber])
  @@index([assetId, versionNumber])
  @@index([campaignId, reviewStatus])
  @@index([organizationId])
  @@index([dnaRecordId])
  @@index([vaultId])
  @@map("asset_versions")
}

enum AssetTimelineType {
  CREATED
  PROTECTED
  CERTIFICATE
  MONITORING_STARTED
  MONITORING_SCAN
  DISCOVERY
  TAMPERING
  INVESTIGATION
  EVIDENCE
  ALERT
  RESOLVED
  STATUS_CHANGE
  NOTE
  EXPORT_CAPTURE
  /// Exchange lifecycle — keyed on Asset.id so an asset's commercial history
  /// (listed → sold → shared → viewed) lives alongside its protection history.
  LISTED
  SOLD
  SHARED
  SHARE_VIEWED
  SHARE_DOWNLOADED
  /// Commerce provenance (Phase 1) — emitted going forward only.
  /// No historical events are fabricated for pre-existing rows.
  PAID
  DELIVERED
  DOWNLOADED
  REVIEWED
  REFUNDED
  /// Phase 2 — marketplace engagement + license lifecycle.
  /// Emitted from the real user action only; never backfilled from counters.
  VIEWED
  LIKED
  WISHLIST_ADDED
  WISHLIST_REMOVED
  CART_ADDED
  CART_REMOVED
  LISTING_UPDATED
  PRICE_CHANGED
  LICENSE_CREATED
  DISPUTED
}

/// Central aggregate for digital asset protection (image/video/document/audio).
model Asset {
  id               String      @id @default(uuid())
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  ownerUserId      String
  assetType        AssetType   @default(IMAGE)
  status           AssetStatus @default(DRAFT)
  originalFilename String
  mimeType         String
  sizeBytes        Int         @default(0)
  contentHash      String?
  vaultId          String?
  dnaId            String?
  certificateId    String?
  monitorRecordId  String?
  campaignId       String?
  /// Monitoring profile: PENDING | RUNNING | PAUSED | FAILED | DISABLED
  monitorStatus    String      @default("PENDING")
  monitorJobId     String?
  sourcePlatform   String?
  sourceUrl        String?
  capturedVia      String      @default("extension_publish_guardian")
  clientRequestId  String?
  riskScore        Int         @default(0)
  riskSeverity     String      @default("LOW")
  discoveriesCount Int         @default(0)
  lastScanAt       DateTime?
  lastDiscoveryAt  DateTime?
  /// Video/document DNA fingerprints and adapter metadata (additive JSON)
  fingerprints     Json?
  metadata         Json?

  ownerUser      User                 @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  dnaRecord      DnaRecord?           @relation(fields: [dnaId], references: [id], onDelete: SetNull)
  campaign       Campaign?            @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  protectedPosts ProtectedPost[]
  timeline       AssetTimelineEvent[]
  discoveries    AssetDiscovery[]
  platformLinks  AssetPlatformLink[]
  versions       AssetVersion[]

  @@unique([ownerUserId, clientRequestId])
  @@index([ownerUserId, createdAt])
  @@index([assetType])
  @@index([status])
  @@index([monitorStatus])
  @@index([dnaId])
  @@index([vaultId])
  @@index([campaignId])
  @@map("assets")
}

