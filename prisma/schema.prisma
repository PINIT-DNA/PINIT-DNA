  updatedAt       DateTime @updatedAt
  assetId         String
  platform        String?
  sourcePlatform  String?
  url             String
  pageTitle       String?
  similarity      Float    @default(0)
  similarityScore Float    @default(0)
  tampering       String   @default("UNKNOWN")
  tampered        Boolean  @default(false)
  confidence      Float    @default(0)
