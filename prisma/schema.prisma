model BiometricIdentity {
  id                  String               @id @default(uuid())
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  userId              String               @unique
  identityHash        String               @unique
  status              String               @default("ACTIVE")
  enrolledAt          DateTime             @default(now())
  lastVerifiedAt      DateTime?
  fusionVersion       String               @default("1.0")
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  faceTemplate        FaceTemplate?
  voiceTemplate       VoiceTemplate?
  fingerprintTemplate FingerprintTemplate?

  @@map("biometric_identities")
}

model FaceTemplate {
  id                   String            @id @default(uuid())
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @default(now()) @updatedAt
  biometricIdentityId  String            @unique
  templateCipher       String
  templateHash         String            @unique
  dimension            Int               @default(128)
  algorithm            String            @default("face-api-v1")
  // Versioning so a future face-model upgrade can migrate/re-enroll templates
  // deliberately instead of silently invalidating every existing one.
  embeddingVersion     String            @default("1")
  modelVersion         String            @default("face-api-tiny-v1")
  algorithmVersion     String            @default("1")
  /// PAD sharpness at enrollment. Null when no server-side signal was available.
  qualityScore         Float?
  status               String            @default("ACTIVE")
  encryptionKeyVersion String            @default("v1")
  biometricIdentity    BiometricIdentity @relation(fields: [biometricIdentityId], references: [id], onDelete: Cascade)

  @@index([templateHash])
  @@map("face_templates")
}

model VoiceTemplate {
  id                   String            @id @default(uuid())
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @default(now()) @updatedAt
  biometricIdentityId  String            @unique
  templateCipher       String
  templateHash         String            @unique
  dimension            Int               @default(128)
  algorithm            String            @default("web-audio-fft-v1")
  embeddingVersion     String            @default("1")
  modelVersion         String            @default("web-audio-fft-v1")
  algorithmVersion     String            @default("1")
  /// Always null today — voice quality is gated client-side and never sent to the server.
  qualityScore         Float?
  status               String            @default("ACTIVE")
  encryptionKeyVersion String            @default("v1")
  biometricIdentity    BiometricIdentity @relation(fields: [biometricIdentityId], references: [id], onDelete: Cascade)

  @@index([templateHash])
  @@map("voice_templates")
}

/// NOT a fingerprint biometric. This is a derived hash proxy over the WebAuthn
/// credential id / device fingerprint — PINIT never receives or stores fingerprint
/// images, minutiae, or any platform-authenticator biometric material.
model FingerprintTemplate {
  id                   String            @id @default(uuid())
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @default(now()) @updatedAt
  biometricIdentityId  String            @unique
  templateCipher       String
  templateHash         String            @unique
  dimension            Int               @default(128)
  algorithm            String            @default("webauthn-device-v1")
  credentialId         String?
  embeddingVersion     String            @default("1")
  modelVersion         String            @default("webauthn-device-v1")
  algorithmVersion     String            @default("1")
  /// Always null — a derived device proxy has no captured-sample quality.
  qualityScore         Float?
  status               String            @default("ACTIVE")
  encryptionKeyVersion String            @default("v1")
  biometricIdentity    BiometricIdentity @relation(fields: [biometricIdentityId], references: [id], onDelete: Cascade)

  @@index([templateHash])
  @@map("fingerprint_templates")
}

