model ShareLink {
  id                        String               @id @default(uuid())
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  vaultId                   String
  dnaRecordId               String
  filename                  String
  mimeType                  String               @default("application/octet-stream")
  token                     String               @unique
  expiresAt                 DateTime?
  maxViews                  Int?
  viewCount                 Int                  @default(0)
  isActive                  Boolean              @default(true)
  allowDownload             Boolean              @default(false)
  requireName               Boolean              @default(false)
  note                      String?
  oneTimeUse                Boolean              @default(false)
  maxDownloads              Int?
  downloadCount             Int                  @default(0)
  allowedCountries          String[]             @default([])
  allowedDeviceTypes        String[]             @default([])
  allowedIpPrefixes         String[]             @default([])
  requireOtp                Boolean              @default(false)
  recipientEmail            String?
  otpCodeHash               String?
  otpExpiresAt              DateTime?
  otpVerified               Boolean              @default(false)
  tokenSignature            String?
  privacyMaskingEnabled     Boolean              @default(false)
  maskEmail                 Boolean              @default(false)
  maskPhone                 Boolean              @default(false)
  maskAadhaar               Boolean              @default(false)
  maskPan                   Boolean              @default(false)
  maskAddress               Boolean              @default(false)
  maskCustomPatterns        String?
  requestLocation           Boolean              @default(false)
  ownerUserId               String?
  depth                     Int                  @default(0)
  forwardedByLabel          String?
  forwardingDetected        Boolean              @default(false)
  intendedDeviceFingerprint String?
  intendedIpAddress         String?
  /// Review mode — collaboration on top of access control. Default false, so
  /// every share link that already exists keeps behaving exactly as it did.
  /// Approval is deliberately NOT here yet: it carries legal weight and needs
  /// identity-bound evidence, which lands with the approvals phase.
  reviewMode                Boolean              @default(false)
  allowComments             Boolean              @default(false)
  allowChangeRequest        Boolean              @default(false)
  /// Approval carries legal weight, so it is a separate grant from commenting.
  allowApproval             Boolean              @default(false)
  /// Pins the link to one version. Null means "whatever is current".
  reviewVersionId           String?

  linkType                  String               @default("PARENT")
  parentLinkId              String?
  recipientLabel            String?
  corporateIpRanges         String[]             @default([])
  domainRestrictions        String[]             @default([])
  firstViewExpiresAfter     Int?
  forwardConfidence         Int                  @default(0)
  forwardRiskScore          Int                  @default(0)
  forwardStatus             String               @default("CLEAN")
  oneDeviceOnly             Boolean              @default(false)
  oneIpOnly                 Boolean              @default(false)
  shareRecipientId          String?
  torBlock                  Boolean              @default(true)
  vpnBlock                  Boolean              @default(false)
  watermarkCode             String?
  /// Canonical Asset.id. ShareLink is otherwise keyed on vaultId/dnaRecordId;
  /// this is the identity that crosses the Hub↔Exchange boundary and makes an
  /// asset's full history answerable from one id.
  assetId                   String?
  /// "hub" (owner sharing their own vault file) | "exchange_license" (buyer
  /// sharing a file they licensed on Exchange). Licensed shares are exempt from
  /// the FEATURE_SMART_SHARE / FEATURE_TRACKING plan gates — the purchase paid for it.
  sourceContext             String               @default("hub")
  exchangeOrderId           String?
  exchangeSealId            String?
  licenseTier               String?
  forwardEvents             LinkForwardEvent[]
  accessLogs                ShareAccessLog[]
  blockedViewers            BlockedShareViewer[]
  ownerUser                 User?                @relation(fields: [ownerUserId], references: [id])
  parentLink                ShareLink?           @relation("LinkHierarchy", fields: [parentLinkId], references: [id])
  childLinks                ShareLink[]          @relation("LinkHierarchy")
  shareRecipient            ShareRecipient?      @relation(fields: [shareRecipientId], references: [id])
  unmaskRequests            UnmaskRequest[]
  viewerMessages            ShareViewerMessage[]

  @@index([token])
  @@index([vaultId])
  @@index([dnaRecordId])
  @@index([parentLinkId])
  @@index([shareRecipientId])
  @@index([forwardStatus])
  @@index([assetId])
  @@index([exchangeSealId])
  @@index([reviewVersionId])
  @@map("share_links")
}

