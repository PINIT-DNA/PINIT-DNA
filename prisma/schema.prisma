  @@map("subscriptions")
}

/// Per-user or org feature overrides (enterprise custom deals)
model FeatureEntitlement {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  userId     String
  featureKey String
  enabled    Boolean  @default(true)
  note       String?

  @@unique([userId, featureKey])
  @@index([userId])
  @@map("feature_entitlements")
}

model BillingHistory {
  id             String               @id @default(uuid())
  createdAt      DateTime             @default(now())
  subscriptionId String
  amountCents    Int                  @default(0)
  currency       String               @default("USD")
  provider       BillingProvider      @default(NONE)
  externalId     String?
  status         BillingHistoryStatus @default(PENDING)
  rawPayload     Json                 @default("{}")
  subscription   Subscription         @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([provider])
  @@map("billing_history")
}

model UsageRecord {
  id             String       @id @default(uuid())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  subscriptionId String
  userId         String
  metric         UsageMetric
  value          BigInt       @default(0)
  /// e.g. 2026-07 for monthly rollups
  periodKey      String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, metric, periodKey])
  @@index([userId, metric])
  @@map("usage_records")
}

model ProtectedPost {
  id               String                       @id @default(uuid())
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  tenantId         String?
  ownerUserId      String
  vaultId          String?
  dnaRecordId      String?
  certificateId    String?
  monitorRecordId  String?
  platform         String
  platformPostId   String?
  postUrl          String?
  ownerAccount     String?
  mediaUrl         String?
  mediaHash        String?
  mediaType        String                       @default("IMAGE")
  thumbnail        String?
  caption          String?
  publishedAt      DateTime?
  registeredAt     DateTime                     @default(now())
  watchUrls        String[]                     @default([])
  /// Monitoring profile state: PENDING | RUNNING | PAUSED | FAILED | DISABLED
  monitorStatus    String                       @default("PENDING")
  lastScanAt       DateTime?
  lastDiscoveryAt  DateTime?
  discoveriesCount Int                          @default(0)
  tamperedCount    Int                          @default(0)
  riskScore        Int                          @default(0)
  status           ProtectedPostStatus          @default(REGISTERED)
  extensionVersion String?
  capturedVia      String                       @default("extension_publish_guardian")
  pageTitle        String?
  metadata         Json?
  /// Latest known public URL (may differ from original postUrl)
  currentUrl       String?
  /// External / internal job id for scheduler correlation
  monitorJobId     String?
  lastMonitorError String?
  nextScanAt       DateTime?
  avgScanMs        Int?
  /// LOW | MEDIUM | HIGH | CRITICAL
  riskSeverity     String                       @default("LOW")
  /// Client idempotency key for offline queue recovery
  clientRequestId  String?
  /// Optional link to universal Asset aggregate (additive)
  assetId          String?
  discoveries      ProtectedPostDiscovery[]
  timeline         ProtectedPostTimelineEvent[]
  asset            Asset?                       @relation(fields: [assetId], references: [id])
  dnaRecord        DnaRecord?                   @relation(fields: [dnaRecordId], references: [id])
  ownerUser        User                         @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, clientRequestId])
  @@index([ownerUserId, createdAt])
  @@index([platform])
  @@index([status])
  @@index([monitorStatus])
  @@index([assetId])
  @@index([dnaRecordId])
  @@index([vaultId])
  @@index([mediaHash])
  @@index([postUrl])
  @@index([riskSeverity])
  @@map("protected_posts")
}

model ProtectedPostTimelineEvent {
  id              String                    @id @default(uuid())
  createdAt       DateTime                  @default(now())
  protectedPostId String
  eventType       ProtectedPostTimelineType
  title           String
  detail          String?
  platform        String?
  url             String?
  dnaMatchPercent Float?
  tampered        Boolean?
  riskScore       Int?
  confidence      Float?
  investigationId String?
  evidenceId      String?
  crawlResultId   String?
  payload         Json?
  protectedPost   ProtectedPost             @relation(fields: [protectedPostId], references: [id], onDelete: Cascade)

  @@index([protectedPostId, createdAt])
  @@index([eventType])
  @@map("protected_post_timeline_events")
}

model ProtectedPostDiscovery {
  id                 String        @id @default(uuid())
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  protectedPostId    String
  platform           String?
  discoveryUrl       String
  pageTitle          String?
  matchType          String        @default("POSSIBLE")
  dnaMatchPercent    Float         @default(0)
  similarity         Float         @default(0)
  tampered           Boolean       @default(false)
  tamperSummary      String?
  confidence         Float         @default(0)
  riskScore          Int           @default(0)
  investigationId    String?
  crawlResultId      String?
  alertStatus        String        @default("PENDING")
  evidenceReady      Boolean       @default(false)
  thumbnailUrl       String?
  payload            Json?
  sourcePlatform     String?
  similarityScore    Float         @default(0)
  tamperingStatus    String        @default("UNKNOWN")
  severity           String        @default("LOW")
  matchedVaultId     String?
  matchedDnaRecordId String?
  evidenceId         String?
  firstSeenAt        DateTime      @default(now())
  lastSeenAt         DateTime      @default(now())
  protectedPost      ProtectedPost @relation(fields: [protectedPostId], references: [id], onDelete: Cascade)

  @@index([protectedPostId, createdAt])
  @@index([alertStatus])
  @@index([discoveryUrl])
  @@index([severity])
  @@map("protected_post_discoveries")
}

/// Short-lived codes for Chrome extension OAuth (Hub → extension)
model ExtensionAuthCode {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  code        String    @unique
  ownerUserId String
  extensionId String
  expiresAt   DateTime
  usedAt      DateTime?
  ownerUser   User      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([expiresAt])
  @@map("extension_auth_codes")
}

/// Central aggregate for digital asset protection (image/video/document/audio).
model Asset {
  id               String               @id @default(uuid())
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  ownerUserId      String
  assetType        AssetType            @default(IMAGE)
  status           AssetStatus          @default(DRAFT)
  originalFilename String
  mimeType         String
  sizeBytes        Int                  @default(0)
  contentHash      String?
  vaultId          String?
  dnaId            String?
  certificateId    String?
  monitorRecordId  String?
  /// Monitoring profile: PENDING | RUNNING | PAUSED | FAILED | DISABLED
  monitorStatus    String               @default("PENDING")
  monitorJobId     String?
  sourcePlatform   String?
  sourceUrl        String?
  capturedVia      String               @default("extension_publish_guardian")
  clientRequestId  String?
  riskScore        Int                  @default(0)
  riskSeverity     String               @default("LOW")
  discoveriesCount Int                  @default(0)
  lastScanAt       DateTime?
  lastDiscoveryAt  DateTime?
  /// Video/document DNA fingerprints and adapter metadata (additive JSON)
  fingerprints     Json?
  metadata         Json?
  discoveries      AssetDiscovery[]
  platformLinks    AssetPlatformLink[]
  timeline         AssetTimelineEvent[]
  dnaRecord        DnaRecord?           @relation(fields: [dnaId], references: [id])
  ownerUser        User                 @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  protectedPosts   ProtectedPost[]

  @@unique([ownerUserId, clientRequestId])
  @@index([ownerUserId, createdAt])
  @@index([assetType])
  @@index([status])
  @@index([monitorStatus])
  @@index([dnaId])
  @@index([vaultId])
  @@map("assets")
}

/// Multiple published surfaces for one Asset (Instagram + YouTube + …)
model AssetPlatformLink {
  id             String   @id @default(uuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  assetId        String
  platform       String
  url            String
  platformPostId String?
  /// studio_upload | file-picker | export-gesture | context-menu | …
  uploadMethod   String?
  /// First/original publish surface
  isOriginal     Boolean  @default(false)
  /// original | published | related
  role           String   @default("published")
  metadata       Json?
  asset          Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, platform, url])
  @@index([assetId, createdAt])
  @@index([platform])
  @@index([url])
  @@map("asset_platform_links")
}

model AssetTimelineEvent {
  id              String            @id @default(uuid())
  createdAt       DateTime          @default(now())
  assetId         String
  eventType       AssetTimelineType
  title           String
  detail          String?
  platform        String?
  url             String?
  similarity      Float?
  tampered        Boolean?
  riskScore       Int?
  confidence      Float?
  investigationId String?
  evidenceId      String?
  payload         Json?
  asset           Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, createdAt])
  @@index([eventType])
  @@map("asset_timeline_events")
}

model AssetDiscovery {
  id              String   @id @default(uuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  assetId         String
  platform        String?
  sourcePlatform  String?
  url             String
  pageTitle       String?
  similarity      Float    @default(0)
  similarityScore Float    @default(0)
  tampering       String   @default("UNKNOWN")
  tampered        Boolean  @default(false)
  confidence      Float    @default(0)
  severity        String   @default("LOW")
  riskScore       Int      @default(0)
  matchedAssetId  String?
  matchedVaultId  String?
  matchedDnaId    String?
  investigationId String?
  evidenceId      String?
  firstSeen       DateTime @default(now())
  lastSeen        DateTime @default(now())
  alertStatus     String   @default("PENDING")
  payload         Json?
  asset           Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, createdAt])
  @@index([url])
  @@index([severity])
  @@index([alertStatus])
  @@map("asset_discoveries")
}

model webauthn_credentials {
  id           String   @id
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  credentialId String   @unique
  publicKey    String
  userId       String
  signCount    Int      @default(0)
  deviceType   String?
  backedUp     Boolean  @default(false)
  transports   String[] @default([])
  users        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

