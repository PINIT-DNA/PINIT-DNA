generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model DnaRecord {
  id                    String                    @id @default(uuid())
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  ownerUserId           String?
  imageFilename         String
  imageMimeType         String
  imageSizeBytes        Int
  imageWidthPx          Int?
  imageHeightPx         Int?
  fileType              String?
  engineVersion         String?
  universalFingerprints Json?
  sha256Hash            String?
  schemaVersion         String                    @default("1.0.0")
  status                DnaStatus                 @default(PENDING)
  organizationId        String?
  workspaceId           String?
  departmentId          String?
  /// Whole-file analysis snapshot (auto-run on DNA generate)
  fileAnalysis          Json?
  fileAnalysisLabel     String?
  assets                Asset[]
  behavioralLayer       BehavioralLayer?
  biometricBindLayer    BiometricBindLayer?
  cryptoLayer           CryptoLayer?
  custodyLayer          CustodyLayer?
  dctWatermarkLayer     DctWatermarkLayer?
  deepfakeLayer         DeepfakeLayer?
  department            Department?               @relation(fields: [departmentId], references: [id])
  organization          Organization?             @relation(fields: [organizationId], references: [id])
  ownerUser             User?                     @relation(fields: [ownerUserId], references: [id])
  workspace             Workspace?                @relation(fields: [workspaceId], references: [id])
  lineageFrom           DocumentLineage[]         @relation("LineageFrom")
  lineageTo             DocumentLineage[]         @relation("LineageTo")
  evolutionLayer        EvolutionLayer?
  provenanceEvents      ForensicProvenanceEvent[]
  localFeatureIndex     LocalFeatureIndex?
  metadataLayer         MetadataLayer?
  monitorRecords        MonitorRecord[]
  ocrRecord             OcrRecord?
  originLayer           OriginLayer?
  perceptualLayer       PerceptualLayer?
  protectedPosts        ProtectedPost[]
  relationshipLayer     RelationshipLayer?
  semanticLayer         SemanticLayer?
  spatialAuthPackage    SpatialAuthPackage?
  stegoLayer            StegoLayer?
  structuralLayer       StructuralLayer?
  trackedExports        TrackedExportPackage[]
  vaultRecord           VaultRecord?
  verifications         VerificationLog[]
  zkProofLayer          ZkProofLayer?

  /// Document page pixel-protection — a rendered document page is its own
  /// DnaRecord (full image pipeline reused as-is), linked back to the parent
  /// document DnaRecord (e.g. a PDF) via these two fields.
  documentDnaRecordId  String?
  pageNumber           Int?
  documentDnaRecord    DnaRecord?  @relation("DocumentPages", fields: [documentDnaRecordId], references: [id], onDelete: Cascade)
  pages                DnaRecord[] @relation("DocumentPages")

  @@index([organizationId])
  @@index([ownerUserId])
  @@index([documentDnaRecordId])
  @@map("dna_records")
}

/// Phase 1 — SpatialAuthPackage: one compact package per DNA image (no per-pixel rows)
model SpatialAuthPackage {
  id                String    @id @default(uuid())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  dnaRecordId       String    @unique
  ownerUserId       String
  width             Int
  height            Int
  /// Decode policy id (file-pixel-order-v1 = no EXIF rotate, RGB removeAlpha)
  orientationPolicy String    @default("file-pixel-order-v1")
  /// Content-seal HMAC or sha256:… / dna:… parent binding
  globalDnaRef      String
  keyId             String
  algorithmVersion  String
  primaryScale      Int
  scales            Int[]
  merkleRoot        String    @db.Char(64)
  rootMac           String    @db.Char(64)
  /// Compact binary block leaves (SPB1)
  blockBlob         Bytes
  /// Phase 3A — Hierarchical Keyed Cell Auth (8×8 HKCA); nullable = Phase1/2-only packages
  pixelAlgoVersion  String?
  pixelScheme       String?
  pixelKeyId        String?
  pixelCellSize     Int?
  pixelTagBytes     Int?
  pixelAuthBlob     Bytes?
  pixelAuthRoot     String?   @db.Char(64)
  pixelRootMac      String?   @db.Char(64)
  /// Phase 4E — dense enrolled 1×1 HMAC tags (SP1T blob; not per-pixel rows)
  pixel1AlgoVersion String?
  pixel1KeyId       String?
  pixel1TagBytes    Int?
  pixel1AuthBlob    Bytes?
  pixel1AuthRoot    String?   @db.Char(64)
  pixel1RootMac     String?   @db.Char(64)
  dnaRecord         DnaRecord @relation(fields: [dnaRecordId], references: [id], onDelete: Cascade)
  ownerUser         User      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId])
  @@map("spatial_auth_packages")
}

model ForensicProvenanceEvent {
  id              String     @id @default(uuid())
  createdAt       DateTime   @default(now())
  /// Append-only event type (DNA_GENERATED, VAULT_STORED, CERTIFICATE_ISSUED, …)
  eventType       String
  dnaRecordId     String?
  vaultId         String?
  certificateId   String?
  tepCode         String?
  shareLinkId     String?
  investigationId String?
  actorUserId     String?
  actorLabel      String?
  /// Human-readable summary for reports
  summary         String
  /// Structured payload (geo, device, hashes, tamper flags) — never written into DNA
  payload         Json       @default("{}")
  country         String?
  region          String?
  city            String?
  latitude        Float?
  longitude       Float?
  /// ip | gps | none — never fabricate GPS
  locationSource  String?
  ipAddress       String?
  userAgent       String?
  device          String?
  /// Optional idempotency key to avoid duplicate appends for the same action
  dedupeKey       String?    @unique
  dnaRecord       DnaRecord? @relation(fields: [dnaRecordId], references: [id])

  @@index([dnaRecordId, createdAt])
  @@index([vaultId, createdAt])
  @@index([eventType])
  @@index([investigationId])
  @@map("forensic_provenance_events")
}

model LocalFeatureIndex {
  id             String          @id @default(uuid())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  dnaRecordId    String          @unique
  ownerUserId    String
  vaultId        String?
  imageWidth     Int
  imageHeight    Int
  patchSize      Int             @default(32)
  gridCols       Int
  gridRows       Int
  patchCount     Int
  globalPHash    String?
  orbKeypoints   Int             @default(0)
  orbDescriptors Json?
  indexVersion   String          @default("2.0.0")
  status         String          @default("COMPLETE")
  patches        LocalDnaPatch[]
  dnaRecord      DnaRecord       @relation(fields: [dnaRecordId], references: [id], onDelete: Cascade)
  ownerUser      User            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId])
  @@map("local_feature_indexes")
}

model LocalDnaPatch {
  id            String            @id @default(uuid())
  indexId       String
  patchIndex    Int
  gridX         Int
  gridY         Int
  pHash16       String
  edgeSignature String?
  colorVector   Json?
  frequencySig  String?
  aHash8        String?
  dHash8        String?
  scale         Int               @default(32)
  textureSig    String?
  index         LocalFeatureIndex @relation(fields: [indexId], references: [id], onDelete: Cascade)

  @@unique([indexId, patchIndex])
  @@index([indexId])
  @@index([indexId, scale])
  @@index([pHash16])
  @@map("local_dna_patches")
}

model DeepfakeLayer {
  id             String    @id @default(uuid())
  createdAt      DateTime  @default(now())
  dnaRecordId    String    @unique
  deepfakeScore  Float     @default(0)
  isDeepfake     Boolean   @default(false)
  confidence     Float     @default(0)
  modelVersion   String    @default("1.0")
  analysisMethod String    @default("pixel-noise-analysis")
  metadata       Json?
  flagged        Boolean   @default(false)
  dnaRecord      DnaRecord @relation(fields: [dnaRecordId], references: [id], onDelete: Cascade)

  @@map("deepfake_layers")
}

model DctWatermarkLayer {
  id             String    @id @default(uuid())
  createdAt      DateTime  @default(now())
  dnaRecordId    String    @unique
  watermarkHash  String
  ownerIdEncoded String
  timestamp      DateTime  @default(now())
  method         String    @default("dct-frequency")
  strength       Float     @default(0.85)
  embedded       Boolean   @default(false)
  survivalScore  Float     @default(0)
  dnaRecord      DnaRecord @relation(fields: [dnaRecordId], references: [id], onDelete: Cascade)

  @@map("dct_watermark_layers")
}

model CustodyLayer {
  id              String    @id @default(uuid())
  createdAt       DateTime  @default(now())
  dnaRecordId     String    @unique
  custodyChain    Json      @default("[]")
  dmcaReady       Boolean   @default(true)
  evidenceHash    String?
  legalTimestamp  DateTime  @default(now())
  jurisdiction    String    @default("IN")
  courtAdmissible Boolean   @default(true)
  dnaRecord       DnaRecord @relation(fields: [dnaRecordId], references: [id], onDelete: Cascade)

  @@map("custody_layers")
}

model ZkProofLayer {
  id             String    @id @default(uuid())
  createdAt      DateTime  @default(now())
  dnaRecordId    String    @unique
  commitmentHash String
  proofData      String
  publicKey      String
  verified       Boolean   @default(false)
  proofType      String    @default("hash-commitment")
  dnaRecord      DnaRecord @relation(fields: [dnaRecordId], references: [id], onDelete: Cascade)

  @@map("zk_proof_layers")
}

model BiometricBindLayer {
  id             String    @id @default(uuid())
  createdAt      DateTime  @default(now())
  dnaRecordId    String    @unique
  biometricHash  String
  biometricType  String    @default("face-embedding")
  bindMethod     String    @default("hmac-sha256")
  userId         String
  deviceInfo     String?
  embeddedInFile Boolean   @default(false)
  dnaRecord      DnaRecord @relation(fields: [dnaRecordId], references: [id], onDelete: Cascade)

  @@map("biometric_bind_layers")
}

model CryptoLayer {
  id             String    @id @default(uuid())
  createdAt      DateTime  @default(now())
  dnaRecordId    String    @unique
  sha256Hash     String    @db.Char(64)
  normalizedHash String    @db.Char(64)
  blake3Hash     String?   @db.Char(64)
  dnaRecord      DnaRecord @relation(fields: [dnaRecordId], references: [id], onDelete: Cascade)

  @@map("crypto_layers")
}

model StructuralLayer {
  id              String    @id @default(uuid())
  createdAt       DateTime  @default(now())
  dnaRecordId     String    @unique
  edgeMapB64      String
  edgeVectors     Json
  edgeSignature64 String    @db.Char(16)
  algorithm       String    @default("canny")
  dnaRecord       DnaRecord @relation(fields: [dnaRecordId], references: [id], onDelete: Cascade)

  @@map("structural_layers")
}

model PerceptualLayer {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  dnaRecordId String    @unique
  pHash64     String    @db.Char(16)
  pHash256    String    @db.Char(64)
  aHash64     String    @db.Char(16)
  dHash64     String    @db.Char(16)
  dnaRecord   DnaRecord @relation(fields: [dnaRecordId], references: [id], onDelete: Cascade)

  @@map("perceptual_layers")
}

model SemanticLayer {
  id               String    @id @default(uuid())
  createdAt        DateTime  @default(now())
  dnaRecordId      String    @unique
  histogramR       Json
  histogramG       Json
  histogramB       Json
  histogramH       Json
  histogramS       Json
  dominantColors   Json
  colorFingerprint String    @db.Char(12)
  dnaRecord        DnaRecord @relation(fields: [dnaRecordId], references: [id], onDelete: Cascade)

  @@map("semantic_layers")
}

model MetadataLayer {
  id           String    @id @default(uuid())
  createdAt    DateTime  @default(now())
  dnaRecordId  String    @unique
  exifData     Json?
  deviceMake   String?
  deviceModel  String?
  software     String?
  capturedAt   DateTime?
  gpsLatitude  Float?
  gpsLongitude Float?
  iptcData     Json?
  xmpData      Json?
  metadataHash String    @db.Char(64)
  dnaRecord    DnaRecord @relation(fields: [dnaRecordId], references: [id], onDelete: Cascade)

  @@map("metadata_layers")
}

model StegoLayer {
  id                 String    @id @default(uuid())
  createdAt          DateTime  @default(now())
  dnaRecordId        String    @unique
  embedded           Boolean   @default(false)
  capacityBits       Int?
  usedBits           Int?
  payloadHmac        String    @db.Char(64)
  channel            String    @default("B")
  carrierPath        String?
  /// Full ownership watermark details (vault/user/upload meta + tile fingerprints)
  ownershipSignature Json?
  ownershipAlgorithm String?
  ownershipTileCount Int?
  ownershipDnaFp     String?   @db.Char(32)
  dnaRecord          DnaRecord @relation(fields: [dnaRecordId], references: [id], onDelete: Cascade)

  @@index([ownershipDnaFp])
  @@map("stego_layers")
}

model BehavioralLayer {
  id           String    @id @default(uuid())
  createdAt    DateTime  @default(now())
  dnaRecordId  String    @unique
  behaviorHash String
  uploadMs     Int
  sessionToken String?
  userAgent    String?
  processingMs Int       @default(0)
  dnaRecord    DnaRecord @relation(fields: [dnaRecordId], references: [id], onDelete: Cascade)

  @@map("behavioral_layers")
}

model RelationshipLayer {
  id            String    @id @default(uuid())
  createdAt     DateTime  @default(now())
  dnaRecordId   String    @unique
  graphHash     String?
  relatedIds    String[]
  relationTypes String[]
  processingMs  Int       @default(0)
  dnaRecord     DnaRecord @relation(fields: [dnaRecordId], references: [id], onDelete: Cascade)

  @@map("relationship_layers")
}

model OriginLayer {
  id           String    @id @default(uuid())
  createdAt    DateTime  @default(now())
  dnaRecordId  String    @unique
  originBundle Json
  bundleHash   String
  processingMs Int       @default(0)
  dnaRecord    DnaRecord @relation(fields: [dnaRecordId], references: [id], onDelete: Cascade)

  @@map("origin_layers")
}

model EvolutionLayer {
  id           String    @id @default(uuid())
  createdAt    DateTime  @default(now())
  dnaRecordId  String    @unique
  merkleRoot   String?
  mutationLog  Json      @default("[]")
  version      Int       @default(1)
  processingMs Int       @default(0)
  dnaRecord    DnaRecord @relation(fields: [dnaRecordId], references: [id], onDelete: Cascade)

  @@map("evolution_layers")
}

model VerificationLog {
  id               String    @id @default(uuid())
  createdAt        DateTime  @default(now())
  dnaRecordId      String
  passed           Boolean
  layerResults     Json
  similarityScores Json
  confidenceScore  Float
  layersChecked    String[]
  requestIp        String?
  dnaRecord        DnaRecord @relation(fields: [dnaRecordId], references: [id], onDelete: Cascade)

  @@map("verification_logs")
}

model VaultRecord {
  id                  String    @id @default(uuid())
  createdAt           DateTime  @default(now())
  dnaRecordId         String    @unique
  encryptedFilePath   String
  originalFileName    String
  originalMimeType    String
  encryptedSizeBytes  Int
  originalSizeBytes   Int
  encryptionAlgorithm String    @default("AES-256-GCM")
  keyDerivation       String    @default("HKDF-SHA256")
  ivHex               String    @db.Char(24)
  authTagHex          String    @db.Char(32)
  /// Whole-file content class: ORIGINAL | AI_GENERATED | AI_EDITED | SCREENSHOT | DOCUMENT | COURSE_MATERIAL | UNKNOWN
  contentLabel        String?
  /// Full file-analysis snapshot shown in Vault Explorer Details
  contentAnalysis     Json?
  dnaRecord           DnaRecord @relation(fields: [dnaRecordId], references: [id], onDelete: Cascade)

  @@index([contentLabel])
  @@map("vault_records")
}

model User {
  id                       String                 @id @default(uuid())
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  shortId                  String                 @unique
  email                    String?                @unique
  passwordHash             String?
  fullName                 String                 @default("PINIT User")
  role                     UserRole               @default(USER)
  isActive                 Boolean                @default(true)
  lastLoginAt              DateTime?
  avatarUrl                String?
  bio                      String?
  country                  String?
  jobTitle                 String?
  notifyCertificates       Boolean                @default(true)
  notifyMonitoring         Boolean                @default(true)
  notifyRiskAlerts         Boolean                @default(true)
  notifyShareAccess        Boolean                @default(true)
  notifyUpdates            Boolean                @default(false)
  organization             String?
  phone                    String?
  theme                    String                 @default("light")
  authMethod               String                 @default("password")
  faceEmbedding            Float[]                @default([])
  faceRegistered           Boolean                @default(false)
  faceRegisteredAt         DateTime?
  deviceFingerprint        String?
  voiceEmbedding           Float[]                @default([])
  voiceRegistered          Boolean                @default(false)
  webauthnCredentialId     String?
  notifyVault              Boolean                @default(true)
  notifyDna                Boolean                @default(true)
  notifyInvestigation      Boolean                @default(true)
  notifyAutomation         Boolean                @default(true)
  notifySecurity           Boolean                @default(true)
  notifyReports            Boolean                @default(true)
  notifySystem             Boolean                @default(true)
  accountType              AccountType            @default(INDIVIDUAL)
  organizationIndustry     OrganizationIndustry?
  organizationSize         OrganizationSize?
  workspaceName            String?
  businessSetupCompletedAt DateTime?
  assets                   Asset[]
  biometricIdentity        BiometricIdentity?
  certificates             Certificate[]
  dnaRecords               DnaRecord[]
  evidenceRecords          EvidenceRecord[]
  extensionAuthCodes       ExtensionAuthCode[]
  localFeatureIndexes      LocalFeatureIndex[]
  loginHistory             LoginHistory[]
  monitorRecords           MonitorRecord[]
  notifications            Notification[]
  organizationMemberships  OrganizationMember[]
  ownedOrganization        Organization?
  platformEvents           PlatformEvent[]
  protectedPosts           ProtectedPost[]
  refreshTokens            RefreshToken[]
  securityEvents           SecurityEvent[]
  shareLinks               ShareLink[]
  shareRecipients          ShareRecipient[]
  spatialAuthPackages      SpatialAuthPackage[]
  subscription             Subscription?
  userDevices              UserDevice[]
  userSessions             UserSession[]
  webauthn_credentials     webauthn_credentials[]

  @@map("users")
}

model Organization {
  id                 String                    @id @default(uuid())
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  shortId            String                    @unique
  name               String?
  industry           OrganizationIndustry?
  country            String?
  logoUrl            String?
  ownerUserId        String                    @unique
  setupCompletedAt   DateTime?
  setupSkippedAt     DateTime?
  welcomeDismissedAt DateTime?
  organizationSize   OrganizationSize?
  businessType       String?
  website            String?
  registrationNumber String?
  gst                String?
  addressLine1       String?
  addressLine2       String?
  city               String?
  state              String?
  postalCode         String?
  supportEmail       String?
  supportPhone       String?
  foundedYear        Int?
  linkedIn           String?
  aboutDescription   String?
  services           String?
  notes              String?
  departments        Department[]
  dnaRecords         DnaRecord[]
  apiKeys            OrganizationApiKey[]
  auditLogs          OrganizationAuditLog[]
  integrations       OrganizationIntegration[]
  invites            OrganizationInvite[]
  members            OrganizationMember[]
  webhooks           OrganizationWebhook[]
  ownerUser          User                      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  workspaces         Workspace[]

  @@index([ownerUserId])
  @@map("organizations")
}

model Workspace {
  id             String       @id @default(uuid())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  name           String       @default("Main Workspace")
  isDefault      Boolean      @default(true)
  organizationId String
  shortId        String?      @unique
  dnaRecords     DnaRecord[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("workspaces")
}

model Department {
  id             String               @id @default(uuid())
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  name           String
  description    String?
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dnaRecords     DnaRecord[]
  members        OrganizationMember[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("departments")
}

model OrganizationMember {
  id              String                 @id @default(uuid())
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  organizationId  String
  userId          String
  role            OrganizationMemberRole @default(MEMBER)
  departmentId    String?
  invitedByUserId String?
  joinedAt        DateTime               @default(now())
  department      Department?            @relation(fields: [departmentId], references: [id])
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_members")
}

model OrganizationInvite {
  id              String                   @id @default(uuid())
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  organizationId  String
  email           String?
  inviteeShortId  String?
  role            OrganizationMemberRole   @default(MEMBER)
  token           String                   @unique
  status          OrganizationInviteStatus @default(PENDING)
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  acceptedUserId  String?
  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([email])
  @@map("organization_invites")
}

model OrganizationAuditLog {
  id             String       @id @default(uuid())
  createdAt      DateTime     @default(now())
  organizationId String
  actorUserId    String?
  action         String
  entityType     String?
  entityId       String?
  title          String
  detail         Json?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("organization_audit_logs")
}

model OrganizationApiKey {
  id              String       @id @default(uuid())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organizationId  String
  name            String
  keyPrefix       String
  keyHash         String       @unique
  createdByUserId String
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("organization_api_keys")
}

/// Outbound webhooks — PinIT pushes events to customer/Exchange URLs
model OrganizationWebhook {
  id              String       @id @default(uuid())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organizationId  String
  name            String
  targetUrl       String
  secret          String
  events          String[]     @default([])
  isActive        Boolean      @default(true)
  createdByUserId String
  lastDeliveryAt  DateTime?
  lastStatusCode  Int?
  lastError       String?
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("organization_webhooks")
}

/// Connected third-party tools (Slack, Drive, …) — Phase 1: Slack Incoming Webhook
model OrganizationIntegration {
  id              String       @id @default(uuid())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organizationId  String
  provider        String
  displayName     String?
  status          String       @default("CONNECTED")
  /// Encrypted-at-rest preferred later; store Incoming Webhook URL / tokens for MVP
  configJson      Json         @default("{}")
  createdByUserId String
  lastUsedAt      DateTime?
  disconnectedAt  DateTime?
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@index([organizationId])
  @@map("organization_integrations")
}

model LoginHistory {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  userId     String
  method     String   @default("face")
  ip         String?
  userAgent  String?
  device     String?
  browser    String?
  os         String?
  city       String?
  country    String?
  success    Boolean  @default(true)
  failReason String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("login_history")
}

model BiometricIdentity {
  id                  String               @id @default(uuid())
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  userId              String               @unique
  identityHash        String               @unique
  status              String               @default("ACTIVE")
  enrolledAt          DateTime             @default(now())
  lastVerifiedAt      DateTime?
  fusionVersion       String               @default("1.0")
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  faceTemplate        FaceTemplate?
  fingerprintTemplate FingerprintTemplate?
  voiceTemplate       VoiceTemplate?

  @@map("biometric_identities")
}

model FaceTemplate {
  id                   String            @id @default(uuid())
  createdAt            DateTime          @default(now())
  biometricIdentityId  String            @unique
  templateCipher       String
  templateHash         String            @unique
  dimension            Int               @default(128)
