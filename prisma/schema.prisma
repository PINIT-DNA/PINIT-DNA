generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model DnaRecord {
  id                    String             @id @default(uuid())
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  imageFilename         String
  imageMimeType         String
  imageSizeBytes        Int
  imageWidthPx          Int?
  imageHeightPx         Int?
  fileType              String?
  engineVersion         String?
  universalFingerprints Json?
  sha256Hash            String?
  schemaVersion         String             @default("1.0.0")
  status                DnaStatus          @default(PENDING)
  ownerUserId           String?
  organizationId        String?
  workspaceId           String?
  departmentId          String?
  /// Pre-existing column, restored here to match live DB — not otherwise used by this change.
  documentDnaRecordId   String?
  /// Pre-existing column, restored here to match live DB — not otherwise used by this change.
  pageNumber            Int?
  behavioralLayer       BehavioralLayer?
  cryptoLayer           CryptoLayer?
  ownerUser             User?              @relation(fields: [ownerUserId], references: [id])
  organization          Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  workspace             Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  department            Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  lineageFrom           DocumentLineage[]  @relation("LineageFrom")
  lineageTo             DocumentLineage[]  @relation("LineageTo")
  evolutionLayer        EvolutionLayer?
  metadataLayer         MetadataLayer?
  monitorRecords        MonitorRecord[]
  ocrRecord             OcrRecord?
  originLayer           OriginLayer?
  perceptualLayer       PerceptualLayer?
  relationshipLayer     RelationshipLayer?
  semanticLayer         SemanticLayer?
  stegoLayer            StegoLayer?
  structuralLayer       StructuralLayer?
  vaultRecord           VaultRecord?
  verifications         VerificationLog[]

  /// Whole-file analysis snapshot (auto-run on DNA generate)
  fileAnalysis      Json?
  fileAnalysisLabel String?

  // Layers 11-15
  deepfakeLayer      DeepfakeLayer?
  dctWatermarkLayer  DctWatermarkLayer?
  custodyLayer       CustodyLayer?
  zkProofLayer       ZkProofLayer?
  biometricBindLayer BiometricBindLayer?
  trackedExports     TrackedExportPackage[]
  localFeatureIndex  LocalFeatureIndex?
  provenanceEvents   ForensicProvenanceEvent[]
  /// Publish Guardian — posts protected via Chrome extension (additive)
  protectedPosts     ProtectedPost[]
  /// Universal assets linked to this DNA (additive)
  assets             Asset[]
  /// Spatial auth package (schema reconciliation — pre-existing table)
  spatialAuthPackage SpatialAuthPackage?

  @@index([organizationId])
  @@index([ownerUserId])
  @@map("dna_records")
}

// ── Forensic Provenance (append-only lifecycle events — NEVER mutates DNA) ─────
// DNA = immutable identity. Location, downloads, tamper, investigations are events.
model ForensicProvenanceEvent {
  id              String   @id @default(uuid())
  createdAt       DateTime @default(now())
  /// Append-only event type (DNA_GENERATED, VAULT_STORED, CERTIFICATE_ISSUED, …)
  eventType       String
  dnaRecordId     String?
  vaultId         String?
  certificateId   String?
  tepCode         String?
  shareLinkId     String?
  investigationId String?
  actorUserId     String?
  actorLabel      String?
  /// Human-readable summary for reports
  summary         String
  /// Structured payload (geo, device, hashes, tamper flags) — never written into DNA
  payload         Json     @default("{}")
  country         String?
  region          String?
  city            String?
  latitude        Float?
  longitude       Float?
  /// ip | gps | none — never fabricate GPS
  locationSource  String?
  ipAddress       String?
  userAgent       String?
  device          String?
  /// Optional idempotency key to avoid duplicate appends for the same action
  dedupeKey       String?  @unique

  dnaRecord DnaRecord? @relation(fields: [dnaRecordId], references: [id], onDelete: SetNull)

  @@index([dnaRecordId, createdAt])
  @@index([vaultId, createdAt])
  @@index([eventType])
  @@index([investigationId])
  @@map("forensic_provenance_events")
}

// ── Local DNA Feature Index (patch-level fingerprints for crop/screenshot recovery) ──
model LocalFeatureIndex {
  id             String          @id @default(uuid())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  dnaRecordId    String          @unique
  ownerUserId    String
  vaultId        String?
  imageWidth     Int
  imageHeight    Int
  patchSize      Int             @default(32)
  gridCols       Int
  gridRows       Int
  patchCount     Int
  globalPHash    String?
  orbKeypoints   Int             @default(0)
  orbDescriptors Json?
  indexVersion   String          @default("2.0.0")
  status         String          @default("COMPLETE")
  dnaRecord      DnaRecord       @relation(fields: [dnaRecordId], references: [id], onDelete: Cascade)
  ownerUser      User            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  patches        LocalDnaPatch[]

  @@index([ownerUserId])
  @@map("local_feature_indexes")
}

model LocalDnaPatch {
  id            String            @id @default(uuid())
  indexId       String
  patchIndex    Int
  gridX         Int
  gridY         Int
  scale         Int               @default(32)
  pHash16       String
  dHash8        String?
  aHash8        String?
  edgeSignature String?
  colorVector   Json?
  frequencySig  String?
  textureSig    String?
  index         LocalFeatureIndex @relation(fields: [indexId], references: [id], onDelete: Cascade)

  @@unique([indexId, patchIndex])
  @@index([indexId])
  @@index([indexId, scale])
  @@index([pHash16])
  @@map("local_dna_patches")
}

// ── Layer 11: AI Deepfake Detection ──────────────────────────────────────────
model DeepfakeLayer {
  id             String    @id @default(uuid())
  createdAt      DateTime  @default(now())
  dnaRecordId    String    @unique
  deepfakeScore  Float     @default(0)
  isDeepfake     Boolean   @default(false)
  confidence     Float     @default(0)
  modelVersion   String    @default("1.0")
  analysisMethod String    @default("pixel-noise-analysis")
  metadata       Json?
  flagged        Boolean   @default(false)
  dnaRecord      DnaRecord @relation(fields: [dnaRecordId], references: [id], onDelete: Cascade)

  @@map("deepfake_layers")
}

// ── Layer 12: Invisible DCT Watermark ────────────────────────────────────────
model DctWatermarkLayer {
  id             String    @id @default(uuid())
  createdAt      DateTime  @default(now())
  dnaRecordId    String    @unique
  watermarkHash  String
  ownerIdEncoded String
  timestamp      DateTime  @default(now())
  method         String    @default("dct-frequency")
  strength       Float     @default(0.85)
  embedded       Boolean   @default(false)
  survivalScore  Float     @default(0)
  dnaRecord      DnaRecord @relation(fields: [dnaRecordId], references: [id], onDelete: Cascade)

  @@map("dct_watermark_layers")
}

// ── Layer 13: Legal Chain of Custody ─────────────────────────────────────────
model CustodyLayer {
  id              String    @id @default(uuid())
  createdAt       DateTime  @default(now())
  dnaRecordId     String    @unique
  custodyChain    Json      @default("[]")
  dmcaReady       Boolean   @default(true)
  evidenceHash    String?
  legalTimestamp  DateTime  @default(now())
  jurisdiction    String    @default("IN")
  courtAdmissible Boolean   @default(true)
  dnaRecord       DnaRecord @relation(fields: [dnaRecordId], references: [id], onDelete: Cascade)

  @@map("custody_layers")
}

// ── Layer 14: Zero-Knowledge Ownership Proof ─────────────────────────────────
model ZkProofLayer {
  id             String    @id @default(uuid())
  createdAt      DateTime  @default(now())
  dnaRecordId    String    @unique
  commitmentHash String
  proofData      String
  publicKey      String
  verified       Boolean   @default(false)
  proofType      String    @default("hash-commitment")
  dnaRecord      DnaRecord @relation(fields: [dnaRecordId], references: [id], onDelete: Cascade)

  @@map("zk_proof_layers")
}

// ── Layer 15: Biometric Identity Bind ────────────────────────────────────────
model BiometricBindLayer {
  id             String    @id @default(uuid())
  createdAt      DateTime  @default(now())
  dnaRecordId    String    @unique
  biometricHash  String
  biometricType  String    @default("face-embedding")
  bindMethod     String    @default("hmac-sha256")
  userId         String
  deviceInfo     String?
  embeddedInFile Boolean   @default(false)
  dnaRecord      DnaRecord @relation(fields: [dnaRecordId], references: [id], onDelete: Cascade)

  @@map("biometric_bind_layers")
}

model CryptoLayer {
  id             String    @id @default(uuid())
  createdAt      DateTime  @default(now())
  dnaRecordId    String    @unique
  sha256Hash     String    @db.Char(64)
  normalizedHash String    @db.Char(64)
  blake3Hash     String?   @db.Char(64)
  dnaRecord      DnaRecord @relation(fields: [dnaRecordId], references: [id], onDelete: Cascade)

  @@map("crypto_layers")
}

model StructuralLayer {
  id              String    @id @default(uuid())
  createdAt       DateTime  @default(now())
  dnaRecordId     String    @unique
  edgeMapB64      String
  edgeVectors     Json
  edgeSignature64 String    @db.Char(16)
  algorithm       String    @default("canny")
  dnaRecord       DnaRecord @relation(fields: [dnaRecordId], references: [id], onDelete: Cascade)

  @@map("structural_layers")
}

model PerceptualLayer {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  dnaRecordId String    @unique
  pHash64     String    @db.Char(16)
  pHash256    String    @db.Char(64)
  aHash64     String    @db.Char(16)
  dHash64     String    @db.Char(16)
  dnaRecord   DnaRecord @relation(fields: [dnaRecordId], references: [id], onDelete: Cascade)

  @@map("perceptual_layers")
}

model SemanticLayer {
  id               String    @id @default(uuid())
  createdAt        DateTime  @default(now())
  dnaRecordId      String    @unique
  histogramR       Json
  histogramG       Json
  histogramB       Json
  histogramH       Json
  histogramS       Json
  dominantColors   Json
  colorFingerprint String    @db.Char(12)
  dnaRecord        DnaRecord @relation(fields: [dnaRecordId], references: [id], onDelete: Cascade)

  @@map("semantic_layers")
}

model MetadataLayer {
  id           String    @id @default(uuid())
  createdAt    DateTime  @default(now())
  dnaRecordId  String    @unique
  exifData     Json?
  deviceMake   String?
  deviceModel  String?
  software     String?
  capturedAt   DateTime?
  gpsLatitude  Float?
  gpsLongitude Float?
  iptcData     Json?
  xmpData      Json?
  metadataHash String    @db.Char(64)
  dnaRecord    DnaRecord @relation(fields: [dnaRecordId], references: [id], onDelete: Cascade)

  @@map("metadata_layers")
}

model StegoLayer {
  id                 String    @id @default(uuid())
  createdAt          DateTime  @default(now())
  dnaRecordId        String    @unique
  embedded           Boolean   @default(false)
  capacityBits       Int?
  usedBits           Int?
  payloadHmac        String    @db.Char(64)
  channel            String    @default("B")
  carrierPath        String?
  /// Full ownership watermark details (vault/user/upload meta + tile fingerprints)
  ownershipSignature Json?
  ownershipAlgorithm String?
  ownershipTileCount Int?
  ownershipDnaFp     String?   @db.Char(32)
  dnaRecord          DnaRecord @relation(fields: [dnaRecordId], references: [id], onDelete: Cascade)

  @@index([ownershipDnaFp])
  @@map("stego_layers")
}

model BehavioralLayer {
  id           String    @id @default(uuid())
  createdAt    DateTime  @default(now())
  dnaRecordId  String    @unique
  behaviorHash String
  uploadMs     Int
  sessionToken String?
  userAgent    String?
  processingMs Int       @default(0)
  dnaRecord    DnaRecord @relation(fields: [dnaRecordId], references: [id], onDelete: Cascade)

  @@map("behavioral_layers")
}

model RelationshipLayer {
  id            String    @id @default(uuid())
  createdAt     DateTime  @default(now())
  dnaRecordId   String    @unique
  graphHash     String?
  relatedIds    String[]
  relationTypes String[]
  processingMs  Int       @default(0)
  dnaRecord     DnaRecord @relation(fields: [dnaRecordId], references: [id], onDelete: Cascade)

  @@map("relationship_layers")
}

model OriginLayer {
  id           String    @id @default(uuid())
  createdAt    DateTime  @default(now())
  dnaRecordId  String    @unique
  originBundle Json
  bundleHash   String
  processingMs Int       @default(0)
  dnaRecord    DnaRecord @relation(fields: [dnaRecordId], references: [id], onDelete: Cascade)

  @@map("origin_layers")
}

model EvolutionLayer {
  id           String    @id @default(uuid())
  createdAt    DateTime  @default(now())
  dnaRecordId  String    @unique
  merkleRoot   String?
  mutationLog  Json      @default("[]")
  version      Int       @default(1)
  processingMs Int       @default(0)
  dnaRecord    DnaRecord @relation(fields: [dnaRecordId], references: [id], onDelete: Cascade)

  @@map("evolution_layers")
}

model VerificationLog {
  id               String    @id @default(uuid())
  createdAt        DateTime  @default(now())
  dnaRecordId      String
  passed           Boolean
  layerResults     Json
  similarityScores Json
  confidenceScore  Float
  layersChecked    String[]
  requestIp        String?
  dnaRecord        DnaRecord @relation(fields: [dnaRecordId], references: [id], onDelete: Cascade)

  @@map("verification_logs")
}

model VaultRecord {
  id                  String    @id @default(uuid())
  createdAt           DateTime  @default(now())
  dnaRecordId         String    @unique
  encryptedFilePath   String
  originalFileName    String
  originalMimeType    String
  encryptedSizeBytes  Int
  originalSizeBytes   Int
  encryptionAlgorithm String    @default("AES-256-GCM")
  keyDerivation       String    @default("HKDF-SHA256")
  ivHex               String    @db.Char(24)
  authTagHex          String    @db.Char(32)
  /// Whole-file content class: ORIGINAL | AI_GENERATED | AI_EDITED | SCREENSHOT | DOCUMENT | COURSE_MATERIAL | UNKNOWN
  contentLabel        String?
  /// Full file-analysis snapshot shown in Vault Explorer Details
  contentAnalysis     Json?
  dnaRecord           DnaRecord @relation(fields: [dnaRecordId], references: [id], onDelete: Cascade)

  @@index([contentLabel])
  @@map("vault_records")
}

model User {
  id                       String                @id @default(uuid())
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  shortId                  String                @unique
  email                    String?               @unique
  passwordHash             String?
  fullName                 String                @default("PINIT User")
  role                     UserRole              @default(USER)
  isActive                 Boolean               @default(true)
  lastLoginAt              DateTime?
  avatarUrl                String?
  bio                      String?
  country                  String?
  jobTitle                 String?
  notifyCertificates       Boolean               @default(true)
  notifyMonitoring         Boolean               @default(true)
  notifyRiskAlerts         Boolean               @default(true)
  notifyShareAccess        Boolean               @default(true)
  notifyUpdates            Boolean               @default(false)
  notifyVault              Boolean               @default(true)
  notifyDna                Boolean               @default(true)
  notifyInvestigation      Boolean               @default(true)
  notifyAutomation         Boolean               @default(true)
  notifySecurity           Boolean               @default(true)
  notifyReports            Boolean               @default(true)
  notifySystem             Boolean               @default(true)
  organization             String?
  organizationIndustry     OrganizationIndustry?
  organizationSize         OrganizationSize?
  workspaceName            String?
  businessSetupCompletedAt DateTime?
  phone                    String?
  theme                    String                @default("light")
  accountType              AccountType           @default(INDIVIDUAL)

  // Face Recognition Auth
  faceEmbedding        Float[]   @default([])
  faceRegistered       Boolean   @default(false)
  faceRegisteredAt     DateTime?
  voiceEmbedding       Float[]   @default([])
  voiceRegistered      Boolean   @default(false)
  webauthnCredentialId String?
  deviceFingerprint    String?
  authMethod           String    @default("password")

  webauthnCredentials WebAuthnCredential[]

  certificates        Certificate[]
  dnaRecords          DnaRecord[]
  localFeatureIndexes LocalFeatureIndex[]
  evidenceRecords     EvidenceRecord[]
  loginHistory        LoginHistory[]
  monitorRecords      MonitorRecord[]
  notifications       Notification[]
  platformEvents      PlatformEvent[]
  refreshTokens       RefreshToken[]
  shareLinks          ShareLink[]
  shareRecipients     ShareRecipient[]

  // Enterprise biometric auth (separate from business data)
  biometricIdentity BiometricIdentity?
  userSessions      UserSession[]
  userDevices       UserDevice[]
  securityEvents    SecurityEvent[]

  // Freemium subscription (additive — does not affect DNA/Vault/auth)
  subscription Subscription?

  // Business organization (owner on Free tier — extensible for Enterprise teams)
  ownedOrganization       Organization?
  organizationMemberships OrganizationMember[]

  /// Publish Guardian (additive — does not affect existing modules)
  protectedPosts      ProtectedPost[]
  extensionAuthCodes  ExtensionAuthCode[]
  /// Universal Asset Protection (additive — Asset-first layer)
  assets              Asset[]
  /// Spatial auth packages (schema reconciliation — pre-existing table)
  spatialAuthPackages SpatialAuthPackage[]

  @@map("users")
}

model Organization {
  id                 String                    @id @default(uuid())
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  shortId            String                    @unique
  name               String?
  industry           OrganizationIndustry?
  organizationSize   OrganizationSize?
  businessType       String?
  country            String?
  website            String?
  registrationNumber String?
  gst                String?
  addressLine1       String?
  addressLine2       String?
  city               String?
  state              String?
  postalCode         String?
  supportEmail       String?
  supportPhone       String?
  foundedYear        Int?
  linkedIn           String?
  aboutDescription   String?                   @db.Text
  services           String?                   @db.Text
  notes              String?                   @db.Text
  logoUrl            String?
  ownerUserId        String                    @unique
  ownerUser          User                      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  setupCompletedAt   DateTime?
  setupSkippedAt     DateTime?
  welcomeDismissedAt DateTime?
  workspaces         Workspace[]
  departments        Department[]
  members            OrganizationMember[]
  invites            OrganizationInvite[]
  auditLogs          OrganizationAuditLog[]
  apiKeys            OrganizationApiKey[]
  webhooks           OrganizationWebhook[]
  integrations       OrganizationIntegration[]
  dnaRecords         DnaRecord[]
  clients            Client[]
  campaigns          Campaign[]

  @@index([ownerUserId])
  @@map("organizations")
}

/// A business's customer relationship — the agency operating layer's first missing
/// piece. Distinct from the business's own internal Department/Workspace structure.
model Client {
  id              String       @id @default(uuid())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  companyName     String?
  website         String?
  contactName     String?
  contactEmail    String?
  notes           String?      @db.Text
  createdByUserId String
  campaigns       Campaign[]

  @@index([organizationId])
  @@map("clients")
}

/// Operational container for a client's work — the natural home for Assets,
/// People and (in later phases) Approvals/Rights.
model Campaign {
  id              String           @id @default(uuid())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name            String
  description     String?          @db.Text
  status          CampaignStatus   @default(ACTIVE)
  startDate       DateTime?
  endDate         DateTime?
  budgetCents     Int?
  createdByUserId String
  assets          Asset[]
  members         CampaignMember[]
  messages        CampaignMessage[]

  @@index([organizationId])
  @@index([clientId])
  @@map("campaigns")
}

enum CampaignStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

/// A person connected to a Campaign's work — internal staff (userId set) or a
/// lightweight external creator/collaborator (no account, no membership tier).
/// External creators are never OrganizationMembers; they receive access only
/// through the existing scoped ShareLink pattern.
model CampaignMember {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  campaignId    String
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId        String?
  name          String?
  platform      String?
  profileUrl    String?
  roleLabel     String?
  isExternal    Boolean  @default(false)
  addedByUserId String

  @@unique([campaignId, userId])
  @@index([campaignId])
  @@index([userId])
  @@map("campaign_members")
}

model Workspace {
  id             String       @id @default(uuid())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  shortId        String?      @unique
  name           String       @default("Main Workspace")
  isDefault      Boolean      @default(true)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dnaRecords     DnaRecord[]

  @@index([organizationId])
  @@map("workspaces")
}

model Department {
  id             String               @id @default(uuid())
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  name           String
  description    String?
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        OrganizationMember[]
  dnaRecords     DnaRecord[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("departments")
}

model OrganizationMember {
  id              String                 @id @default(uuid())
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  organizationId  String
  userId          String
  role            OrganizationMemberRole @default(MEMBER)
  departmentId    String?
  invitedByUserId String?
  joinedAt        DateTime               @default(now())
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  department      Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_members")
}

model OrganizationInvite {
  id              String                   @id @default(uuid())
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  organizationId  String
  email           String?
  inviteeShortId  String?
  role            OrganizationMemberRole   @default(MEMBER)
  token           String                   @unique
  status          OrganizationInviteStatus @default(PENDING)
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  acceptedUserId  String?
  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([email])
  @@map("organization_invites")
}

model OrganizationAuditLog {
  id             String       @id @default(uuid())
  createdAt      DateTime     @default(now())
  organizationId String
  actorUserId    String?
  action         String
  entityType     String?
  entityId       String?
  title          String
  detail         Json?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("organization_audit_logs")
}

model OrganizationApiKey {
  id              String       @id @default(uuid())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organizationId  String
  name            String
  keyPrefix       String
  keyHash         String       @unique
  createdByUserId String
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("organization_api_keys")
}

/// Outbound webhooks — PinIT pushes events to customer/Exchange URLs
model OrganizationWebhook {
  id              String       @id @default(uuid())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organizationId  String
  name            String
  targetUrl       String
  secret          String
  events          String[]     @default([])
  isActive        Boolean      @default(true)
  createdByUserId String
  lastDeliveryAt  DateTime?
  lastStatusCode  Int?
  lastError       String?
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("organization_webhooks")
}

/// Connected third-party tools (Slack, Drive, …) — Phase 1: Slack Incoming Webhook
model OrganizationIntegration {
  id              String       @id @default(uuid())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organizationId  String
  provider        String
  displayName     String?
  status          String       @default("CONNECTED")
  /// Encrypted-at-rest preferred later; store Incoming Webhook URL / tokens for MVP
  configJson      Json         @default("{}")
  createdByUserId String
  lastUsedAt      DateTime?
  disconnectedAt  DateTime?
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

