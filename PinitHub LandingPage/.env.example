# Copy to `.env` and fill in. `.env` is gitignored.
#
# Local development:
#   docker compose up -d
#   npm run setup
#   npm run dev
#
# Dual deploy (recommended):
#   Landing Vercel project:  APP_SURFACE=public
#   Admin Vercel project:    APP_SURFACE=admin
#   Both share the same Render DATABASE_URL.

# Local Postgres (Docker Compose — port 5434)
DATABASE_URL="postgresql://pinithub:pinithub@localhost:5434/pinithub"

# Production example (Render Postgres):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"

# public | admin | full (default full for local)
APP_SURFACE="full"

# Dual-deploy cache sync + “Save & view live site”
# Generate once; use the SAME value on BOTH Vercel projects
REVALIDATE_SECRET="another-long-random-string-at-least-32-chars"
# Only required on the ADMIN project (no trailing slash)
LANDING_URL="https://pinit-landing-page.vercel.app"

# Live PinIT Hub product (optional)
NEXT_PUBLIC_HUB_APP_URL="https://dna-pinit-web.vercel.app"

# Watch Platform video (YouTube / Vimeo / ScreenPal / MP4). Also editable in Admin → Hero → videoUrl.
NEXT_PUBLIC_DEMO_VIDEO_URL="https://go.screenpal.com/watch/cOj123nv0bo"

SEED_ADMIN_EMAIL="admin@pinithub.com"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
SEED_ADMIN_NAME="PINITHUB Owner"
