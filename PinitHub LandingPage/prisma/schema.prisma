// PINITHUB — content + operations database.
//
// Every string the landing page renders lives in one of these models, so the
// marketing site can be edited entirely from /admin without a deploy.
//
// Conventions:
//   * `order`      — ascending sort key for collections rendered as lists.
//   * `id Int @default(1)` — singleton: exactly one row, edited as a form.
//   * `icon`       — a lucide-react export name, resolved through lib/icons.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ------------------------------------------------------------------ *
 *  Access control
 * ------------------------------------------------------------------ */

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  /// OWNER (full control incl. user management) | ADMIN (content + inbox) | EDITOR (content only)
  role         String    @default("ADMIN")
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  /// Bumped on password change / forced logout — invalidates issued tokens.
  tokenVersion Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs AuditLog[]
}

/// Append-only trail of every mutation made through the admin panel.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userEmail  String
  /// CREATE | UPDATE | DELETE | REORDER | LOGIN | LOGIN_FAILED | STATUS
  action     String
  collection String
  recordId   String   @default("")
  summary    String   @default("")
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([collection])
}

/* ------------------------------------------------------------------ *
 *  Section chrome — the editorial header above each section
 * ------------------------------------------------------------------ */

/// One row per landing-page section. `visible` removes the section from the
/// page entirely, which is how sections are turned off without a deploy.
model SectionMeta {
  id        String   @id @default(cuid())
  key       String   @unique
  index     String
  label     String
  title     String
  lede      String   @default("")
  visible   Boolean  @default(true)
  order     Int      @default(0)
  updatedAt DateTime @updatedAt
}

/* ------------------------------------------------------------------ *
 *  Hero
 * ------------------------------------------------------------------ */

model HeroContent {
  id           Int    @id @default(1)
  badgeLabel   String @default("New")
  badgeText    String @default("The world's first Digital Asset Intelligence Platform")
  headline1    String @default("One Platform.")
  headline2    String @default("Infinite Digital")
  headline3    String @default("Possibilities.")
  lede         String
  ctaPrimary   String @default("Book a Live Demo")
  ctaSecondary String @default("Watch Platform")
  /// YouTube, Vimeo, or direct video file URL. Empty scrolls to the platform section instead of opening a player.
  videoUrl     String @default("")
  stat1Key     String @default("7 stages")
  stat1Value   String @default("One asset lifecycle")
  stat2Key     String @default("AI-native")
  stat2Value   String @default("Intelligence at the core")
  stat3Key     String @default("Enterprise")
  stat3Value   String @default("Security by design")
  logosLabel   String @default("Trusted by industry leaders")
}

/// The instrument readouts floating around the 3D core.
model HeroReadout {
  id        String   @id @default(cuid())
  label     String
  value     String
  accent    Boolean  @default(false)
  position  String   @default("top-[14%] left-[4%]")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrustedLogo {
  id        String   @id @default(cuid())
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/* ------------------------------------------------------------------ *
 *  01 — The problem
 * ------------------------------------------------------------------ */

model ProblemItem {
  id        String   @id @default(cuid())
  icon      String
  title     String
  body      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// The "One platform. One intelligent ecosystem." resolution beneath the ledger.
model ProblemContent {
  id              Int    @id @default(1)
  resolutionTitle String @default("One platform. One intelligent ecosystem.")
  resolutionBody  String
}

/* ------------------------------------------------------------------ *
 *  02 — Lifecycle
 * ------------------------------------------------------------------ */

model LifecycleStage {
  id          String   @id @default(cuid())
  key         String
  icon        String
  headline    String
  body        String
  metric      String
  metricLabel String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/* ------------------------------------------------------------------ *
 *  03 — Capabilities
 * ------------------------------------------------------------------ */

model Feature {
  id        String   @id @default(cuid())
  icon      String
  title     String
  body      String
  /// Tailwind column span on the lg grid, e.g. "lg:col-span-2".
  span      String   @default("lg:col-span-2")
  tint      String   @default("#2D7BFF")
  glow      String   @default("rgba(45,123,255,0.16)")
  order     Int      @default(0)
  /// The single full-width card that carries the analytics sparkline.
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/* ------------------------------------------------------------------ *
 *  04 — Ecosystem
 * ------------------------------------------------------------------ */

model EcosystemProduct {
  id        String   @id @default(cuid())
  name      String
  tagline   String
  body      String
  /// Newline-separated bullet points.
  points    String
  tint      String   @default("#55E6FF")
  glow      String   @default("rgba(85,230,255,0.18)")
  /// Which bespoke card illustration to render: career | exchange | vault.
  artKey    String   @default("career")
  ctaLabel  String   @default("Learn more")
  ctaHref   String   @default("#demo")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/* ------------------------------------------------------------------ *
 *  05 — Why PINITHUB
 * ------------------------------------------------------------------ */

model WhyCard {
  id        String   @id @default(cuid())
  kicker    String
  title     String
  /// Newline-separated paragraphs.
  body      String
  glow      String   @default("rgba(85,230,255,0.14)")
  /// fragment | horizon | network
  artKey    String   @default("fragment")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/* ------------------------------------------------------------------ *
 *  06 — Why companies choose us
 * ------------------------------------------------------------------ */

model ChooseUsReason {
  id        String   @id @default(cuid())
  icon      String
  title     String
  body      String
  stat      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/* ------------------------------------------------------------------ *
 *  07 — Industries
 * ------------------------------------------------------------------ */

model Industry {
  id        String   @id @default(cuid())
  icon      String
  name      String
  useCase   String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/* ------------------------------------------------------------------ *
 *  08 — About
 * ------------------------------------------------------------------ */

model AboutContent {
  id      Int    @id @default(1)
  title   String @default("The company behind PINITHUB")
  lede    String
  body1   String
  body2   String
  hqLabel String @default("THECAREERTECH PVT. LTD.")
}

model AboutPillar {
  id        String   @id @default(cuid())
  title     String
  body      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Stat {
  id        String   @id @default(cuid())
  value     Float
  suffix    String   @default("")
  label     String
  decimals  Int      @default(0)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String   @default("")
  initials  String
  tint      String   @default("#55E6FF")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/* ------------------------------------------------------------------ *
 *  09 — Proof
 * ------------------------------------------------------------------ */

model Testimonial {
  id        String   @id @default(cuid())
  quote     String
  name      String
  role      String
  company   String
  initials  String
  tint      String   @default("#55E6FF")
  rating    Int      @default(5)
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/* ------------------------------------------------------------------ *
 *  FAQ — objections answered before the demo call
 * ------------------------------------------------------------------ */

model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/* ------------------------------------------------------------------ *
 *  Closing CTA + global chrome
 * ------------------------------------------------------------------ */

model CtaContent {
  id           Int    @id @default(1)
  headline     String
  lede         String
  ctaPrimary   String @default("Book a Live Demo")
  ctaSecondary String @default("Talk to Sales")
  footnote     String @default("No credit card required · 30-minute session · Tailored to your stack")
}

model SiteSettings {
  id               Int     @id @default(1)
  footerTagline    String
  supportEmail     String  @default("hello@pinithub.com")
  officeAddress    String  @default("TheCareerTech Pvt. Ltd., Hyderabad, India")
  responseTime     String  @default("Under 1 business hour")
  demoLength       String  @default("30 minutes, tailored to your stack")
  newsletterLabel  String  @default("Get the intelligence briefing")
  newsletterHint   String  @default("Monthly. Product, research, and nothing else.")
  copyrightName    String  @default("PINITHUB · TheCareerTech Pvt. Ltd.")
  /// Turns the public demo form on/off without removing the section.
  demoFormEnabled  Boolean @default(true)
  /// Ticker above the navbar. Empty string hides the bar entirely.
  announcement     String  @default("")
  announcementHref String  @default("#demo")

  /// SEO — edited from /admin/settings, read by app/layout.tsx.
  metaTitle       String @default("PINITHUB — One Platform. Infinite Digital Possibilities.")
  metaDescription String @default("PINITHUB is the world's first Digital Asset Intelligence Platform.")
  metaKeywords    String @default("digital asset intelligence, digital asset management, DAM platform")
  siteUrl         String @default("https://pinithub.com")
}

model NavLink {
  id        String   @id @default(cuid())
  label     String
  href      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FooterLink {
  id        String   @id @default(cuid())
  /// Column heading, e.g. "Platform". Use "Legal" for the base-row links.
  column    String
  label     String
  href      String   @default("#demo")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SocialLink {
  id        String   @id @default(cuid())
  /// linkedin | twitter | youtube | github | instagram | facebook
  platform  String
  label     String
  href      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/* ------------------------------------------------------------------ *
 *  Inbox — captured from the public site
 * ------------------------------------------------------------------ */

model DemoRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String
  phone     String   @default("")
  title     String
  country   String
  size      String
  industry  String
  date      String
  time      String
  message   String   @default("")
  /// NEW | CONTACTED | SCHEDULED | COMPLETED | REJECTED
  status    String   @default("NEW")
  /// Internal admin-only notes, never shown publicly.
  notes     String   @default("")
  source    String   @default("landing")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  source    String   @default("footer")
  createdAt DateTime @default(now())
}
