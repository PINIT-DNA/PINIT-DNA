{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "enterprise-gold-dataset-manifest-v1",
  "title": "Enterprise Gold Dataset Manifest",
  "type": "object",
  "required": ["schema", "version", "description", "createdAt", "samples"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "enterprise-gold-dataset-manifest-v1"
    },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "samples": {
      "type": "array",
      "items": { "$ref": "#/definitions/sample" }
    }
  },
  "definitions": {
    "sample": {
      "type": "object",
      "required": [
        "sampleId",
        "relativePath",
        "relationship",
        "originalSampleId",
        "mimeType",
        "expectedVerdicts"
      ],
      "additionalProperties": false,
      "properties": {
        "sampleId": { "type": "string", "minLength": 1 },
        "relativePath": { "type": "string", "minLength": 1 },
        "relationship": {
          "type": "string",
          "enum": [
            "ORIGINAL",
            "JPEG_RECOMPRESSION",
            "PNG_CONVERSION",
            "RESIZE",
            "CROP",
            "SCREENSHOT",
            "METADATA_REMOVED",
            "BRIGHTNESS_ADJUSTMENT",
            "CONTRAST_ADJUSTMENT",
            "WATERMARK_ADDED",
            "WATERMARK_REMOVED",
            "PDF_EXPORT",
            "VIDEO_TRANSCODE",
            "AUDIO_RECOMPRESSION",
            "UNRELATED"
          ]
        },
        "originalSampleId": { "type": ["string", "null"] },
        "mimeType": { "type": "string", "minLength": 1 },
        "expectedVerdicts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "VERIFIED_OWNER",
              "VERIFIED_COPY",
              "DERIVATIVE",
              "POSSIBLE_MATCH",
              "INSUFFICIENT_EVIDENCE",
              "NO_MATCH",
              "INVALID_PACKAGE",
              "PACKAGE_CORRUPTED"
            ]
          }
        },
        "notes": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
