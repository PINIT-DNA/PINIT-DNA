node_modules/
dist/
# But keep client/dist (pre-built frontend for Render to serve share links)
!client/dist/
coverage/
tmp/
.env
*.log
# prisma/migrations/ was ignored here, which is why migration history drifted:
# the files never reached the remote, so nothing could apply them and the
# team fell back on `db push` + scripts/ensure-*.cjs. Migrations are now
# tracked so the SQL is reviewable and travels with the code.

# Vault encrypted files — never commit user data
vault/encrypted/*.enc
vault/encrypted/*.json

# Uploaded temp files
tmp/
data/

# Generated AI/search indexes (rebuild on AI sidecar / Node startup).
# Root `data/` is already ignored; keep python-ai/data binaries untracked too.
python-ai/data/*.bin
python-ai/data/*.bin.corrupt
python-ai/data/*.faiss
python-ai/data/metadata.json
*.faiss


# OS
.DS_Store
Thumbs.db

# Local env overrides
.env.local
.env

# Python AI isolated venv
python-ai/.venv/

# Design-mockup canvas and throwaway maintenance scripts (Exchange)
exchange/.design-preview/
exchange/scripts/

# Decrypted vault recovery output — contains other users private files, never commit
recovered-vault/

# Local DB snapshots taken before migrations — contain real user data, never commit
scripts/backups/

# Python bytecode
__pycache__/
*.pyc

# Throwaway probe scripts
scripts/tmp-*.py
scripts/tmp-*.cjs
tmp-*.cjs

# Large binaries — not source. Fetch or build these locally.
eng.traineddata
*.zip

# Editor
.cursor/
# Next.js build output
.next/
out/
# Dependencies
# Secrets — never commit
.env.*
!.env.example
# Large media
*.mp4

# Local scratch/debug output — logs, tokens, one-off test artifacts
scratch/
*.tsbuildinfo
