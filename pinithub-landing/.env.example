# Copy to `.env` and fill in. `.env` is gitignored.
#
# Same Postgres project as Hub + Exchange (Supabase):
#   Hub      → schema "public"
#   Exchange → schema "exchange"
#   Landing  → schema "landing"   ← this app only
#
# Local optional:
#   docker compose up -d
#   npm run setup
#   npm run dev
#
# Dual deploy (Vercel):
#   Landing: APP_SURFACE=public
#   Admin:   APP_SURFACE=admin
#   Both use the SAME DATABASE_URL (schema=landing).

# ─── Database (same Supabase project as Exchange / Hub) ─────────────────────
# Use the SAME Postgres URI as EXCHANGE_DATABASE_URL / Hub DATABASE_URL.
# Only difference: schema=landing (do NOT use public or exchange).
#
# Local Docker (optional):
# DATABASE_URL="postgresql://pinithub:pinithub@localhost:5434/pinithub?schema=landing"
#
# Production / shared Supabase (same project as Exchange: kqdqmimdqecensurjplh):
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require&schema=landing"

AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"

# public | admin | full (default full for local)
APP_SURFACE="full"

# Dual-deploy cache sync + “Save & view live site”
# Generate once; use the SAME value on BOTH Vercel projects
REVALIDATE_SECRET="another-long-random-string-at-least-32-chars"

# Public landing URL (no trailing slash)
LANDING_URL="https://www.pinithub.com"

# Same-domain Hub (proxied from Landing on pinithub.com)
NEXT_PUBLIC_HUB_APP_URL="https://www.pinithub.com"
HUB_REWRITE_ORIGIN="https://pinit-dna.vercel.app"

# Watch demo video (YouTube / Vimeo / ScreenPal / same-origin MP4). Also editable in Admin → Hero → videoUrl.
NEXT_PUBLIC_DEMO_VIDEO_URL="/videos/PinIT_Hub_Animated_Demo.mp4"

SEED_ADMIN_EMAIL="admin@pinithub.com"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
SEED_ADMIN_NAME="PINITHUB Owner"
