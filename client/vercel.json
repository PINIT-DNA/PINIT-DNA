{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/assets", "destination": "/index.html" },
    { "source": "/assets/:path*", "destination": "/index.html" },
    { "source": "/((?!static/).*)", "destination": "/index.html" }
  ]
}
