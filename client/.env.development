# Local development — uses Vite proxy (no change needed)
# VITE_API_BASE_URL is intentionally NOT set here
# so it falls back to '/api/v1' through the Vite proxy

# Where a certificate's QR code sends the person who scans it. ONE canonical public
# origin for every app that can render a certificate — never the origin that happens
# to be drawing the sheet. Point this at the dedicated verification domain once it is
# live; the built-in default is the Hub deployment that serves /verify-certificate.
VITE_PUBLIC_CERTIFICATE_VERIFY_URL=
